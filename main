from fastapi import FastAPI, HTTPException, Query
from pydantic import BaseModel
from typing import List
from datetime import datetime
import httpx
import uvicorn
import asyncio

app = FastAPI()

class VersionsResponse(BaseModel):
    name: str
    versions: List[str]
    timestamp: str

class OSVQuery(BaseModel):
    package: dict

OSV_API_URL = "https://api.osv.dev/v1/query"

def extract_affected_versions(data: dict) -> List[str]:
    """استخراج الإصدارات المتأثرة من استجابة API"""
    versions = set()
    for vuln in data.get('vulns', []):
        for affected in vuln.get('affected', []):
            for ver in affected.get('versions', []):
                versions.add(ver)
            for range_ in affected.get('ranges', []):
                for event in range_.get('events', []):
                    if 'introduced' in event and event['introduced'] != "0":
                        versions.add(event['introduced'])
                    if 'fixed' in event:
                        versions.add(event['fixed'])
    return list(versions)

async def query_osv_api(client: httpx.AsyncClient, query_payload: OSVQuery) -> dict:
    response = await client.post(OSV_API_URL, json=query_payload.dict())
    if response.status_code == 200:
        return response.json()
    return {}

async def fetch_versions_for_ecosystem(client: httpx.AsyncClient, package_name: str, ecosystem: str) -> List[str]:
    query_payload = OSVQuery(package={"name": package_name, "ecosystem": ecosystem})
    data = await query_osv_api(client, query_payload)
    return extract_affected_versions(data)

async def fetch_all_versions(package_name: str, ecosystems: List[str]) -> List[str]:
    async with httpx.AsyncClient() as client:
        tasks = [fetch_versions_for_ecosystem(client, package_name, eco) for eco in ecosystems]
        results = await asyncio.gather(*tasks)
        
        combined_versions = set()
        for res in results:
            combined_versions.update(res)
            
        return list(combined_versions)

@app.get("/versions", response_model=VersionsResponse)
async def get_versions(
    name: str = Query(..., min_length=1), 
    ecosystems: List[str] = Query(["Debian", "Ubuntu"])
):
    versions = await fetch_all_versions(name, ecosystems)
    
    if not versions:
        raise HTTPException(status_code=404, detail="No vulnerable versions found for this package")

    # ترتيب الإصدارات ألفبائياً وتصاعدياً
    sorted_versions = sorted(versions)
    
    return VersionsResponse(
        name=name,
        versions=sorted_versions,
        timestamp=datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    )

if __name__ == "__main__":
    uvicorn.run(app, host="127.0.0.1", port=8000)